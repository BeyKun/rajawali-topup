APP_NAME=Laravel
VITE_APP_NAME="${APP_NAME}"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MOCK=true

TELKOMSEL_MOCK=true
TELKOMSEL_BASE_URL=https://www.telkomsel.com/api/voucher
TELKOMSEL_TIMEOUT=15

PAYMENT_PROVIDER=mock
# Shared secret used to verify the HMAC-SHA256 signature on real QRIS webhooks.
# Required whenever PAYMENT_PROVIDER is not "mock".
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Midtrans (Payment Provider)
# ---------------------------------------------------------------------------
# Set PAYMENT_PROVIDER=midtrans to use Midtrans. Keep sandbox enabled during
# development; flip MIDTRANS_IS_PRODUCTION=true only for real transactions.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_TIMEOUT=30
# Point the Midtrans dashboard "Payment Notification URL" at:
#   https://<your-domain>/api/v1/webhooks/qris
# Midtrans authenticates each callback with its own signature_key (no shared
# secret needed), so PAYMENT_WEBHOOK_SECRET is only used by other providers.

# Default admin dashboard accounts created by AdminUserSeeder
SEED_SUPER_ADMIN_EMAIL=admin@rajawalitopup.com
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_PASSWORD=password
SEED_OPERATOR_EMAIL=operator@rajawalitopup.com
SEED_OPERATOR_NAME="Operator Kasir"
SEED_OPERATOR_PASSWORD=password

# ---------------------------------------------------------------------------
# Production checklist
# ---------------------------------------------------------------------------
# Set APP_ENV=production and APP_DEBUG=false. Use real credentials and MOCK OFF.
#
#   GOOGLE_MOCK=false
#   TELKOMSEL_MOCK=false
#   PAYMENT_PROVIDER=midtrans   # or xendit / tripay
#   PAYMENT_WEBHOOK_SECRET=<long random secret>
#
# Prefer Redis for CACHE_STORE and QUEUE_CONNECTION in production:
#   CACHE_STORE=redis
#   QUEUE_CONNECTION=redis
#   SESSION_DRIVER=redis
#
# After every deploy / env change, rebuild the caches:
#   php artisan config:cache && php artisan route:cache
#
# Run the queue worker under a process supervisor (e.g. supervisor):
#   php artisan queue:work --sleep=3 --tries=3 --max-time=3600
#
# Drive the scheduler from a single cron entry:
#   * * * * * cd /path-to-project && php artisan schedule:run >> /dev/null 2>&1
